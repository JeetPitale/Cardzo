# Server Port
PORT=4000

# Database URL:
# For SQLite (default local zero-config):
DATABASE_URL="file:./dev.db"

# For PostgreSQL / Neon Database:
# DATABASE_URL="postgresql://username:password@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secrets & Cryptography
JWT_SECRET="cardzo-super-secret-jwt-key-2026-production"
JWT_REFRESH_SECRET="cardzo-refresh-secret-jwt-key-2026"
QR_TOKEN_SECRET="cardzo-dynamic-qr-token-secret-salt-2026"

# Dynamic QR Token Validity (30 to 60 seconds)
QR_TOKEN_EXPIRY_SECONDS=45

# CORS & Uploads
CORS_ORIGIN="*"
UPLOAD_DIR="./uploads"
