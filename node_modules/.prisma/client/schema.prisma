generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  name             String
  role             String   @default("CARDHOLDER") // CARDHOLDER, GARUD, ADMIN
  avatarUrl        String?
  institutionId    String?
  department       String?
  identifierNumber String? // e.g. Student Roll No / Staff ID
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  institution        Institution?        @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  sessions           UserSession[]
  devices            Device[]
  credentials        Credential[]
  qrTokens           QrToken[]
  attendanceSessions AttendanceSession[]
  attendanceEvents   AttendanceEvent[]   @relation("UserAttendanceEvents")
  verifiedEvents     AttendanceEvent[]   @relation("VerifierAttendanceEvents")
  auditLogs          AuditLog[]

  @@index([role])
  @@index([identifierNumber])
}

model Device {
  id           String   @id @default(uuid())
  userId       String
  deviceId     String // Unique client hardware/app instance identifier
  deviceName   String?
  platform     String? // ios, android, web
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions UserSession[]

  @@unique([userId, deviceId])
}

model UserSession {
  id            String    @id @default(uuid())
  userId        String
  deviceId      String?
  sessionToken  String    @unique
  refreshToken  String?   @unique
  isActive      Boolean   @default(true)
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isActive])
}

model Institution {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  logoUrl      String?
  primaryColor String?  @default("#1E40AF")
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users              User[]
  credentials        Credential[]
  attendanceSessions AttendanceSession[]
}

model Credential {
  id                String    @id @default(uuid())
  userId            String
  institutionId     String?
  type              String    @default("COLLEGE_ID") // COLLEGE_ID, DRIVING_LICENSE, EMPLOYEE_ID, MEMBERSHIP, OTHER
  title             String
  issuerName        String
  cardholderName    String
  identifier        String? // Card or Roll Number
  status            String    @default("ACTIVE") // ACTIVE, SUSPENDED, REVOKED, EXPIRED
  isScannedPhysical Boolean   @default(true) // distinguishes physical scan from official digital pass
  isVerified        Boolean   @default(false)
  frontImageUrl     String?
  backImageUrl      String?
  colorTheme        String?   @default("blue")
  category          String    @default("Identity")
  metadataJson      String? // extra fields in JSON
  expiresAt         DateTime?
  isPinned          Boolean   @default(false)
  isArchived        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  qrTokens    QrToken[]

  @@index([userId])
  @@index([status])
  @@index([identifier])
}

model QrToken {
  id                   String    @id @default(uuid())
  token                String    @unique
  userId               String
  credentialId         String?
  expiresAt            DateTime
  isConsumed           Boolean   @default(false)
  consumedAt           DateTime?
  consumedByVerifierId String?
  createdAt            DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

model AttendanceSession {
  id                 String    @id @default(uuid())
  userId             String
  institutionId      String?
  checkInTimestamp   DateTime  @default(now())
  checkOutTimestamp  DateTime?
  checkInVerifierId  String?
  checkOutVerifierId String?
  location           String?   @default("Main Gate Campus Entry")
  status             String    @default("CHECKED_IN") // CHECKED_IN, CHECKED_OUT, FORCE_CLOSED
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution?      @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  events      AttendanceEvent[]

  @@index([userId])
  @@index([status])
  @@index([checkInTimestamp])
}

model AttendanceEvent {
  id         String   @id @default(uuid())
  sessionId  String
  userId     String
  verifierId String?
  eventType  String // CHECK_IN, CHECK_OUT, ADMIN_CORRECTION
  timestamp  DateTime @default(now())
  qrTokenId  String?
  notes      String?
  createdAt  DateTime @default(now())

  session  AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user     User              @relation("UserAttendanceEvents", fields: [userId], references: [id], onDelete: Cascade)
  verifier User?             @relation("VerifierAttendanceEvents", fields: [verifierId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
  @@index([timestamp])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String // LOGIN, LOGOUT, SESSION_INVALIDATED, QR_GENERATED, CHECK_IN, CHECK_OUT, ADMIN_OVERRIDE, etc.
  targetType String?
  targetId   String?
  details    String?
  ipAddress  String?
  timestamp  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([actorId])
}
