{
  "name": "cardzo",
  "version": "1.0.0",
  "private": true,
  "description": "Cardzo Identity Wallet & Dynamic QR Attendance Platform",
  "workspaces": [
    "backend",
    "admin"
  ],
  "scripts": {
    "dev": "npm --prefix backend run dev & npm --prefix admin run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:admin": "npm --prefix admin run dev",
    "dev:mobile": "npm --prefix mobile start",
    "dev:android": "npm --prefix mobile run android",
    "build:apk": "cd mobile/android && ./gradlew assembleDebug",
    "build:admin": "npm --prefix admin run build",
    "prisma:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "postinstall": "prisma generate --schema=backend/prisma/schema.prisma",
    "build": "prisma generate --schema=backend/prisma/schema.prisma && npm --prefix backend run build && npm --prefix admin run build",
    "seed": "npm --prefix backend run prisma:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.8.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
